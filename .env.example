# Copia este archivo a .env y rellena lo que necesites.

# Puerto del servidor (proxy + cliente)
PORT=8787

# Origenes que pueden llamar al proxy desde navegador (CORS), separados por coma.
# Ajusta esta lista si despliegas el frontend o el proxy en otro dominio.
CORS_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,https://alemaner.juanre.es,http://alemaner.juanre.es,https://juanre7.github.io

# ── Proveedor LLM ────────────────────────────────────────────────────
# anthropic (por defecto) u openrouter
LLM_PROVIDER=openrouter

# Clave de servidor (opcional: los usuarios pueden usar BYOK en Ajustes)
# Para OpenRouter (sk-or-...):
OPENROUTER_API_KEY=
# Para Anthropic (sk-ant-...):
# ANTHROPIC_API_KEY=

# Modelo por defecto
LLM_MODEL=deepseek/deepseek-v4-flash

# Razonamiento (thinking): low | medium | high. Vacío = desactivado.
LLM_REASONING_EFFORT=high

# Solo OpenRouter — cómo elegir entre los proveedores que sirven el modelo:
# auto = mejor relación tokens/latencia (el proxy mide TTFT y tok/s de cada
#        consulta real por proveedor y enruta al de menor tiempo total estimado)
# throughput = solo tokens/segundo · latency = solo menor TTFB · price = más barato
LLM_PROVIDER_SORT=auto

# Tokens de salida esperados por consulta, para el score de "auto"
# LLM_EXPECTED_TOKENS=2000

# Lista de modelos para el selector del Modo Dev (GET /api/models, solo en desarrollo)
LLM_MODELS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-pro,deepseek/deepseek-v3.2

# Avanzado (opcional)
# LLM_API_URL=            # URL de la API si no es la del proveedor por defecto
# LLM_MAX_TOKENS=12000    # margen para tokens de razonamiento
# LLM_TIMEOUT_MS=150000  # por defecto: 150s con razonamiento activo, 90s sin él
